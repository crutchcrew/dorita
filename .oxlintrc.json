{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "builtin": true,
    "node": true
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "args": "after-used",
        "caughtErrors": "none"
      }
    ],
    "typescript/consistent-type-imports": "error",
    "import/no-cycle": "error",
    "eqeqeq": ["error", "smart"]
  },
  "overrides": [
    {
      "files": ["packages/rest980/web/**"],
      "env": {
        "browser": true,
        "node": false
      }
    },
    {
      "files": ["packages/*/test/**"],
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    }
  ],
  "ignorePatterns": ["**/dist/**", "**/coverage/**"]
}
