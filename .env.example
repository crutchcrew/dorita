# Copy to .env (Bun loads it automatically) and fill in your robot details.
# Get BLID and PASSWORD with: bun run get-password-cloud <email> <password>
BLID=
PASSWORD=
ROBOT_IP=
FIRMWARE_VERSION=2
PORT=3000

# Optional
# ROBOT_PORT=8883
# KEEP_ALIVE=yes
# ENABLE_LOCAL=yes
# ENABLE_CLOUD=yes
# BASIC_AUTH_USER=
# BASIC_AUTH_PASS=
# SSL_KEY_FILE=
# SSL_CERT_FILE=
# ROBOT_CIPHERS=
# ROBOT_TLS_LEGACY=0
