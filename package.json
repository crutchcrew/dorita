{
  "name": "dorita980-monorepo",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "start": "bun packages/rest980/bin/rest980.ts",
    "dev": "bun --watch packages/rest980/bin/rest980.ts",
    "mock-robot": "bun packages/mock-robot/index.ts",
    "getpassword": "bun packages/dorita980/bin/getpassword.ts",
    "get-password-cloud": "bun packages/dorita980/bin/getPasswordCloud.ts",
    "build": "bun run --filter dorita980 build && bun run --filter rest980 build",
    "typecheck": "bun run --filter \"*\" typecheck",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun test",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.2.21"
  }
}
