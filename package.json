{
  "name": "dorita980",
  "version": "4.0.0",
  "description": "Unofficial iRobot Roomba library, REST API and web UI",
  "main": "./index.js",
  "files": [
    "index.js",
    "lib",
    "bin",
    "server",
    "web"
  ],
  "bin": {
    "get-roomba-password": "./bin/getpassword.js",
    "get-roomba-password-cloud": "./bin/getPasswordCloud.js",
    "rest980": "./bin/rest980.js"
  },
  "scripts": {
    "start": "bun ./bin/rest980.js",
    "dev": "bun --watch ./bin/rest980.js",
    "mock-robot": "bun ./scripts/mock-robot.js",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "eslint .",
    "check": "bun run lint && bun test",
    "getpassword": "bun ./bin/getpassword.js",
    "get-password-cloud": "bun ./bin/getPasswordCloud.js"
  },
  "engines": {
    "bun": ">=1.2.21",
    "node": ">=18.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koalazak/dorita980.git"
  },
  "dependencies": {
    "mqtt": "^2.15.0"
  },
  "devDependencies": {
    "eslint": "^9",
    "mqtt-packet": "^5",
    "neostandard": "^0.14"
  },
  "keywords": [
    "unofficial",
    "iRobot",
    "Roomba",
    "980",
    "wifi",
