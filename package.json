{
  "name": "dorita980",
  "version": "4.0.0",
  "description": "Unofficial iRobot Roomba library, REST API and web UI",
  "keywords": [
    "675",
    "690",
    "960",
    "980",
    "IoT",
    "Roomba",
    "alexa",
    "api",
    "bun",
    "cleaner",
    "cloud",
    "e5",
    "i7",
    "iRobot",
    "library",
    "local",
    "rest",
    "robot",
    "sdk",
    "unofficial",
    "vacuum",
    "web",
    "wifi"
  ],
  "homepage": "https://github.com/koalazak/dorita980#readme",
  "bugs": {
    "url": "https://github.com/koalazak/dorita980/issues"
  },
  "license": "MIT",
  "author": "koalazak <zak.tux@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koalazak/dorita980.git"
  },
  "bin": {
    "get-roomba-password": "./dist/bin/getpassword.js",
    "get-roomba-password-cloud": "./dist/bin/getPasswordCloud.js",
    "rest980": "./dist/bin/rest980.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "bun bin/rest980.ts",
    "dev": "bun --watch bin/rest980.ts",
    "mock-robot": "bun scripts/mock-robot.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && bun build web/app.ts --outdir dist/web --target browser && cp web/index.html web/style.css web/favicon.svg dist/web/",
    "typecheck": "tsc -p . && tsc -p web",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun test",
    "prepublishOnly": "bun run check && bun run build",
    "getpassword": "bun bin/getpassword.ts",
    "get-password-cloud": "bun bin/getPasswordCloud.ts"
  },
  "dependencies": {
    "mqtt": "^2.15.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "mqtt-packet": "^5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.2.21",
    "node": ">=20.19.0"
  }
}
